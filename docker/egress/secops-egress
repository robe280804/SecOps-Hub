#!/bin/sh
# Applies the controlled-egress ruleset for a single environment.
#
# The environment's container traffic is forwarded by the host, so the rules
# belong in Docker's documented DOCKER-USER hook. Every rule matches the
# environment's own network subnet, so environments never affect each other.
#
# Exit codes are the only diagnostics the caller consumes:
#   10  no iptables backend can see Docker's DOCKER-USER chain
#   11  the caller supplied a malformed chain, subnet or address
#   12  the ruleset could not be read back after being applied
set -eu

CHAIN="${SECOPS_CHAIN-}"
ROOT="${SECOPS_ROOT_CHAIN-}"
SUBNET="${SECOPS_SUBNET-}"
RESOLVERS="${SECOPS_RESOLVERS-}"
BLOCKED="${SECOPS_BLOCKED-}"
ALLOWED="${SECOPS_ALLOWED-}"

die() {
    echo "secops-egress: $2" >&2
    exit "$1"
}

valid_cidr() {
    printf '%s' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$'
}

# Defence in depth: these values are already validated by the caller, but they
# are word-split below and must never carry anything but addresses.
printf '%s' "$CHAIN" | grep -Eq '^SECOPS-ENV-[0-9]+$' || die 11 'invalid chain name'
[ "$ROOT" = 'SECOPS-EGRESS' ] || die 11 'invalid root chain name'
valid_cidr "$SUBNET" || die 11 'invalid environment subnet'
for address in $(printf '%s %s %s' "$RESOLVERS" "$BLOCKED" "$ALLOWED" | tr ',' ' '); do
    valid_cidr "$address" || die 11 "invalid address: $address"
done
[ -n "$RESOLVERS" ] || die 11 'no DNS resolver supplied'
[ -n "$BLOCKED" ] || die 11 'no blocked destination supplied'

# Docker may drive either netfilter backend. Picking the one that can already
# see DOCKER-USER is what stops us from writing rules into a table the kernel
# never consults, which would silently leave the environment unfiltered.
IPT=''
for candidate in iptables-nft iptables-legacy iptables; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -t filter -S DOCKER-USER >/dev/null 2>&1; then
        IPT="$candidate"
        break
    fi
done
[ -n "$IPT" ] || die 10 'the DOCKER-USER chain is not visible on any iptables backend'

"$IPT" -t filter -N "$ROOT" 2>/dev/null || true
"$IPT" -t filter -C DOCKER-USER -j "$ROOT" 2>/dev/null || "$IPT" -t filter -I DOCKER-USER 1 -j "$ROOT"

"$IPT" -t filter -N "$CHAIN" 2>/dev/null || true
"$IPT" -t filter -F "$CHAIN"

# Drop stale jumps for this environment, and for any environment that used to
# hold this subnet before Docker recycled it.
"$IPT" -t filter -S "$ROOT" | sed -n "s/^-A $ROOT //p" | while IFS= read -r spec; do
    case " $spec " in
        *" -j $CHAIN "* | *" -s $SUBNET "*)
            "$IPT" -t filter -D "$ROOT" $spec
            ;;
    esac
done

# Order matters: the platform's deny list is applied before anything is
# allowed, so neither a resolver nor an authorised target can reach a private
# network, the host, or the link-local range that serves cloud metadata.
for address in $(printf '%s' "$BLOCKED" | tr ',' ' '); do
    "$IPT" -t filter -A "$CHAIN" -d "$address" -j DROP
done
for address in $(printf '%s' "$RESOLVERS" | tr ',' ' '); do
    "$IPT" -t filter -A "$CHAIN" -d "$address" -p udp --dport 53 -j RETURN
    "$IPT" -t filter -A "$CHAIN" -d "$address" -p tcp --dport 53 -j RETURN
done
if [ -n "$ALLOWED" ]; then
    for address in $(printf '%s' "$ALLOWED" | tr ',' ' '); do
        "$IPT" -t filter -A "$CHAIN" -d "$address" -j RETURN
    done
    "$IPT" -t filter -A "$CHAIN" -j DROP
fi

"$IPT" -t filter -A "$ROOT" -s "$SUBNET" -j "$CHAIN"
"$IPT" -t filter -C "$ROOT" -s "$SUBNET" -j "$CHAIN" 2>/dev/null || die 12 'the ruleset could not be read back'
