# Vite dev proxy target: set this to the backend URL provided by Herd.
API_PROXY_TARGET=http://localhost:8000
# Optional path to your local Herd CA certificate for HTTPS proxy verification.
API_PROXY_CA_FILE=

# Leave empty for same-origin requests through a reverse proxy (recommended).
# For sibling subdomains, use the API origin and configure Laravel CORS,
# SANCTUM_STATEFUL_DOMAINS, and SESSION_DOMAIN accordingly.
VITE_API_ORIGIN=
